{
  "name": "helios-ag/fm-tinymce-bundle",
  "description": "TinyMCE bundle, adds TinyMCE editor to your Symfony project",
  "keywords": ["tinymce", "wisywig", "file manager"],
  "type": "symfony-bundle",
  "homepage": "https://github.com/helios-ag/FMTinyMCEBundle",
  "license": "MIT",
  "minimum-stability": "stable",
  "prefer-stable": true,
  "authors": [
    {
      "name": "Al Ganiev",
      "email": "helios.ag@gmail.com"
    },
    {
      "name": "Symfony Community",
      "homepage": "https://github.com/helios-ag/FMTinyMCEBundle/contributors"
    }
  ],
  "archive": {
    "exclude": ["/tests", "/.github"]
  },
  "require": {
    "php": "^8.2",
    "symfony/asset": "^7.4 || ^8.0",
    "symfony/config": "^7.4 || ^8.0",
    "symfony/dependency-injection": "^7.4 || ^8.0",
    "symfony/filesystem": "^7.4 || ^8.0",
    "symfony/form": "^7.4 || ^8.0",
    "symfony/framework-bundle": "^7.4 || ^8.0",
    "symfony/routing": "^7.4 || ^8.0",
    "symfony/twig-bundle": "^7.4 || ^8.0",
    "tinymce/tinymce": "^8.9"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.0",
    "matthiasnoback/symfony-config-test": "^6.0",
    "matthiasnoback/symfony-dependency-injection-test": "^6.0",
    "phpunit/phpunit": "^11.5",
    "phpstan/phpstan": "^2.0",
    "symfony/phpunit-bridge": "^7.4 || ^8.0"
  },
  "suggest": {
    "helios-ag/fm-elfinder-bundle": "Elfinder bundle, file manager",
    "helios-ag/fm-rfm-bundle": "Richfilemanager bundle, file manager"
  },
  "extra": {
    "branch-alias": {
        "dev-main": "2.0-dev"
    }
  },
  "autoload": {
    "psr-4": { "FM\\TinyMCEBundle\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "FM\\TinyMCEBundle\\Tests\\": "tests/" }
  },
  "scripts": {
    "test": "phpunit",
    "lint": [
      "php-cs-fixer check --diff",
      "phpstan analyse"
    ],
    "copy-tinymce-assets": "FM\\TinyMCEBundle\\Composer\\TinyMCEAssetInstaller::copy"
  }
}
